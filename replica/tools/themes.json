{
 "_doc": "theme -> {kind: hate|missing|unsolved, patterns: regexes matched case-insensitively}",
 "Subscription, billing and refunds": {
  "kind": "hate",
  "patterns": [
   "subscri",
   "charg(ed|ing)",
   "refund",
   "cancel",
   "billing",
   "auto.?renew",
   "free trial",
   "trial"
  ]
 },
 "Paywall: free tier keeps shrinking / everything is Pro": {
  "kind": "hate",
  "patterns": [
   "paywall",
   "\\bpro\\b",
   "premium",
   "pay (for|to)",
   "not free",
   "used to be free",
   "crown",
   "upgrade"
  ]
 },
 "Price too high or rising": {
  "kind": "hate",
  "patterns": [
